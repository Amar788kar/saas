# ==============================================================================
# CRM BTP — Configuration d'environnement (Phase 1)
# ==============================================================================

# Environnement applicatif (development | production | staging)
APP_ENV=development
PORT=8080

# Base de données PostgreSQL (Multi-tenant)
POSTGRES_DB=crm_btp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd_2026
DATABASE_URL=postgres://postgres:postgres_secure_pwd_2026@localhost:5432/crm_btp?sslmode=disable

# Cache & Sessions Redis (Gestion tokens, blacklist et rate-limiting)
REDIS_URL=redis://localhost:6379/0

# Sécurité & Authentification JWT (Au moins 32 caractères aléatoires)
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-btp-crm-2026!
JWT_ISSUER=crm-btp-api
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Localisation & Devises
DEFAULT_CURRENCY=DZD
DEFAULT_COUNTRY=DZ
DEFAULT_LANGUAGE=fr

# Intégrations futures (Phase 7 - Notifications & Phase 9 - IA)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# GEMINI_API_KEY=
